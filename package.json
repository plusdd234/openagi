{
  "name": "openagi",
  "productName": "The seed",
  "version": "0.1.0",
  "private": false,
  "description": "The seed · 开源的 AI 工作流工作台（可视化节点 + 多引擎生图 + 3D 生成）",
  "author": "The seed",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "pack:local": "electron-builder --dir -c.electronDist=node_modules/electron/dist -c.win.signAndEditExecutable=false -c.directories.output=dist-local",
    "dist": "electron-builder --win nsis",
    "dist:local": "electron-builder --win nsis -c.electronDist=node_modules/electron/dist -c.win.signAndEditExecutable=false -c.directories.output=dist-local",
    "test:content": "node tools/electron-content.js",
    "test:headless": "node tools/test-headless.js",
    "gw": "node server/gateway.js",
    "test:gateway": "node tools/gateway.js",
    "test:gateway-client": "node tools/gateway-client.js",
    "chat": "node server/chat.js",
    "test:chat": "node tools/chat.js",
    "app:scan": "node tools/app-scan.js",
    "wt": "node tools/wt.js",
    "test:apps": "node tools/app-registry.js",
    "test:apps-all": "node tools/apps-all.js",
    "test:tabs": "node tools/desk-tabs.js",
    "test:ns": "node tools/ns-guard.js",
    "test:conf": "node tools/conf-guard.js",
    "test:busy": "node tools/chat-busy.js",
    "test:st": "node tools/st-own.js",
    "md:index": "node tools/md-index.js",
    "test:browser": "node tools/probe-browser.js",
    "test:browser-wv": "node tools/probe-browser-webview.js",
    "test:browser-guest": "node tools/probe-browser-guest.js",
    "test:browser-real": "node tools/probe-browser-real.js"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.openagi.desktop",
    "productName": "The seed",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "package.json",
      "index.html",
      "multiview.html",
      "css/**",
      "js/**",
      "apps/**",
      "vendor/**",
      "img/**"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "bridge/plugins"
      },
      {
        "from": "node_modules/playwright-core",
        "to": "bridge/node_modules/playwright-core"
      },
      {
        "from": "server/chat.js",
        "to": "bridge/chat.js"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "The seed",
      "deleteAppDataOnUninstall": false
    },
    "electronDist": "node_modules/electron/dist"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plusdd234/openagi.git"
  },
  "homepage": "https://github.com/plusdd234/openagi#readme",
  "keywords": [
    "ai",
    "workflow",
    "node-editor",
    "image-generation",
    "3d",
    "comfyui",
    "ollama",
    "electron"
  ]
}
