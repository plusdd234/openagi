{
  "name": "openagi",
  "productName": "Open AGI",
  "version": "0.1.0",
  "private": true,
  "description": "Open AGI · 图像修复与 3D 生成工作台",
  "author": "Open AGI",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "pack:local": "electron-builder --dir -c.electronDist=node_modules/electron/dist -c.win.signAndEditExecutable=false -c.directories.output=dist-local",
    "dist": "electron-builder --win nsis",
    "dist:local": "electron-builder --win nsis -c.electronDist=node_modules/electron/dist -c.win.signAndEditExecutable=false -c.directories.output=dist-local",
    "test:content": "node tools/electron-content.js",
    "gw": "node server/gateway.js",
    "test:gateway": "node tools/gateway.js",
    "test:gateway-client": "node tools/gateway-client.js"
  },
  "dependencies": {
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.openagi.desktop",
    "productName": "Open AGI",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "package.json",
      "index.html",
      "css/**",
      "js/**",
      "vendor/**"
    ],
    "extraResources": [
      {
        "from": "relay.js",
        "to": "bridge/relay.js"
      },
      {
        "from": "tripo-web.js",
        "to": "bridge/tripo-web.js"
      },
      {
        "from": "node_modules/playwright-core",
        "to": "bridge/node_modules/playwright-core"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Open AGI",
      "deleteAppDataOnUninstall": false
    },
    "electronDist": "node_modules/electron/dist"
  }
}
